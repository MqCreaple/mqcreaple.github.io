---
import Avatar from '../../../../components/Avatar.astro';
import Base from '../../../../layouts/Base.astro';
import TagCloud from '../../../../components/TagCloud.astro';
import translations from '../../../../i18n/translations.json';
import posts from '../../../../generated/index.json';

export function getStaticPaths() {
  const categories = ['tech', 'humanity', 'casual'];
  const paths = [];
  for (const lang of ['en', 'zh']) {
    for (const cat of categories) {
      paths.push({ params: { lang, cat } });
    }
  }
  return paths;
}

const { lang = 'en', cat = 'tech' } = Astro.params;
const t = translations[lang] ?? translations.en;
const label = t.categories[cat] ?? cat;
const list = posts
  .filter((post) => post.lang === lang && post.category === cat)
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Base title={`${label} · ${t.siteTitle}`} lang={lang}>
  <section class="post-index">
    <h1>{label}</h1>
    <ol class="post-list">
      {
        list.map((post) => (
          <li>
            <a href={`/${lang}/posts/${post.date}/${post.name}/`}>
              <span>{post.title}</span>
              <time datetime={post.date}>{post.date}</time>
            </a>
            {post.summary && <p>{post.summary}</p>}
          </li>
        ))
      }
    </ol>
  </section>
  <Avatar slot="aside" lang={lang} />
  <TagCloud slot="aside" lang={lang} />
</Base>
