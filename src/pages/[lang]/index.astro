---
import Avatar from '../../components/Avatar.astro';
import Base from '../../layouts/Base.astro';
import TagCloud from '../../components/TagCloud.astro';
import translations from '../../i18n/translations.json';
import posts from '../../generated/index.json';
import CategoryBar from '../../components/CategoryBar.astro';

export function getStaticPaths() {
  return ['en', 'zh'].map((lang) => ({ params: { lang } }));
}

const { lang = 'en' } = Astro.params;
const list = posts
  .filter((post) => post.lang === lang)
  .sort((a, b) => b.date.localeCompare(a.date));
const t = translations[lang as keyof typeof translations] ?? translations.en;
---

<Base title={`${t.posts} · ${t.siteTitle}`} lang={lang}>
  <section class="post-index" data-pagefind-ignore>
    <div class="quote-panel">
      {
        t.quotes.map((quote) => (
          <p class="quote-line">
            <span class="quote-native">{quote.text}</span>
            <span class="quote-divider">/</span>
            <span class="quote-translation">{quote.translation}</span>
          </p>
        ))
      }
    </div>
    <CategoryBar />
    <h1>{t.posts}</h1>
    <ol class="post-list">
      {
        list.map((post) => (
          <li>
            <a href={`/${lang}/posts/${post.date}/${post.name}/`}>
              <span>{post.title}</span>
              <time datetime={post.date}>{post.date}</time>
            </a>
            {post.summary && <p class="post-summary">{post.summary}</p>}
          </li>
        ))
      }
    </ol>
  </section>
  <Avatar slot="aside" lang={lang} />
  <TagCloud slot="aside" lang={lang} />
</Base>
