---
import Base from '../../../layouts/Base.astro';
import Instruments from '../../../app/chaotic/components/Instruments.astro';
import Slider from '../../../app/chaotic/components/Slider.astro';
import ModulationPanel from '../../../app/chaotic/components/ModulationPanel.astro';
import translations from '../../../i18n/translations.json';
import '../../../app/chaotic/styles/chaotic.css';

const t = translations['en'] ?? translations.en;
const pageTitle = `Chaotic · ${t.siteTitle}`;
---

<Base
  title={pageTitle}
  description="Procedural ambient music generator: Web Audio virtual instruments (bass, pad, pluck) whose parameters will be driven by a chaotic dynamical system."
>
  <div class="chaotic-app" data-pagefind-ignore>

    <div class="chaotic-instruments" id="chaotic-instruments" aria-label="Virtual instruments">
      <Instruments />
    </div>

    <ModulationPanel />
  </div>

  <Fragment slot="aside">
    <section class="chaotic-card" aria-label="Transport">
      <h2>Transport</h2>
      <div id="chaotic-transport-controls">
        <div class="chaotic-transport-row">
          <div class="chaotic-transport-sliders" id="chaotic-global-controls">
            <Slider inst="global" param="bpm" label="BPM" min={30} max={200} step={1} precision={0} unit="bpm" value={128} />
            <Slider inst="global" param="master" label="Master" min={0} max={1} step={0.01} precision={2} value={0.8} />
          </div>
          <div class="chaotic-start-stack">
            <button type="button" class="chaotic-btn chaotic-btn--transport" id="chaotic-transport-start">Start</button>
            <span class="transport-status">stopped</span>
          </div>
        </div>
      </div>
      <p class="chaotic-muted">The test melody cycles through the instruments, one note per beat at the configured BPM.</p>
    </section>

    <section class="chaotic-card" aria-label="Chaotic dynamics">
      <h2>Chaotic dynamics</h2>
      <div class="lorenz-viz" id="chaotic-lorenz-viz">
        <div class="lorenz-viz-stage">
          <canvas class="lorenz-viz-canvas"></canvas>
        </div>
        <div class="lorenz-viz-strips">
          {['x', 'y', 'z'].map((axis) => (
            <div class="lorenz-viz-strip" data-axis={axis}>
              <span class="lorenz-viz-label">{axis}</span>
              <div class="lorenz-viz-plot" data-plot={axis}></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </Fragment>
</Base>

<script>
  import '../../../app/chaotic/main.ts';
</script>