---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import path from 'node:path';
import AppLayout from '../../../layouts/AppLayout.astro';

export function getStaticPaths() {
  const appsDir = path.join(process.cwd(), 'app');
  if (!existsSync(appsDir)) return [];
  return readdirSync(appsDir, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => ({ params: { name: entry.name } }));
}

const { name } = Astro.params;
const appDir = path.join(process.cwd(), 'app', name);
const metaPath = path.join(appDir, 'metadata.json');
const meta = existsSync(metaPath)
  ? JSON.parse(readFileSync(metaPath, 'utf-8'))
  : { title: name, introduction: '', scripts: [], styles: [] };

function readAppFile(file) {
  const full = path.join(appDir, file);
  return existsSync(full) ? readFileSync(full, 'utf-8') : '';
}

const styles = (meta.styles ?? [])
  .map((file) => `<link rel="stylesheet" href="/app/${name}/${file}" />`)
  .join('\n');
const scripts = (meta.scripts ?? [])
  .map((file) => `<script src="/app/${name}/${file}"></script>`)
  .join('\n');
---

<AppLayout
  title={meta.title}
  description={meta.introduction}
  headHtml={`${styles}\n${scripts}`}
  leftHtml={readAppFile(meta.contentLeft ?? 'left.html')}
  rightHtml={readAppFile(meta.contentRight ?? 'right.html')}
/>
