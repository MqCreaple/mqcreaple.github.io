---
import Avatar from '../../../components/Avatar.astro';
import TagCloud from '../../../components/TagCloud.astro';
import Base from '../../../layouts/Base.astro';
import translations from '../../../i18n/translations.json';

const lang = 'en';
const t = translations[lang] ?? translations.en;
const minecraftYears = new Date().getFullYear() - 2017;
---

<Base title={`${t.about.title} · ${t.siteTitle}`} lang={lang}>
  <section class="about-page">
    <h1>{t.about.title}</h1>

    <p>University of Cambridge '25, majoring in natural science (physical).</p>

    <ul>
      <li>Interests include computational physics, mechanical and electronic engineering, and technology art.</li>
      <li>Proficient in Python, C++, Java, Rust; have some JavaScript/Web development experience.</li>
      <li>Minecraft {minecraftYears}-year player.</li>
    </ul>

    <p>You can also find me at:</p>

    <ul>
      <li><i class="fa-brands fa-github"></i> GitHub: <a href="https://github.com/MqCreaple">MqCreaple</a></li>
      <li><i class="fa-brands fa-bilibili"></i> Bilibili: <a href="https://space.bilibili.com/507017613">mqcreaple</a></li>
      <li><i class="fa-brands fa-discord"></i> Discord: creaple#5811</li>
      <li><i class="fa-solid fa-envelope"></i> Email: <a href="mailto:gmq14159@gmail.com">gmq14159@gmail.com</a></li>
    </ul>
  </section>

  <Avatar slot="aside" lang={lang} />
  <TagCloud slot="aside" lang={lang} />
</Base>