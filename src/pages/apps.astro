---
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import translations from '../i18n/translations.json';

const appsDir = path.join(process.cwd(), 'app');
const astroPagesDir = path.join(process.cwd(), 'src', 'pages', 'app');
const astroSourcesDir = path.join(process.cwd(), 'src', 'app');

/** Read the shared metadata.json fields of one app folder. */
function readAppMeta(dir: string, name: string) {
  const metaPath = path.join(dir, name, 'metadata.json');
  const meta = existsSync(metaPath) ? JSON.parse(readFileSync(metaPath, 'utf-8')) : {};
  return {
    name,
    title: meta.title ?? name,
    introduction: meta.introduction ?? '',
    date: meta.date ?? '',
  };
}

// Legacy standalone apps live in app/<name> with metadata alongside them.
const legacyApps = existsSync(appsDir)
  ? readdirSync(appsDir, { withFileTypes: true })
      .filter((entry) => entry.isDirectory())
      .map((entry) => readAppMeta(appsDir, entry.name))
  : [];

// Astro-native apps live in src/pages/app/<name> with sources in src/app/<name>.
const astroApps = existsSync(astroPagesDir)
  ? readdirSync(astroPagesDir, { withFileTypes: true })
      .filter(
        (entry) =>
          entry.isDirectory() &&
          entry.name !== '[name]' &&
          existsSync(path.join(astroPagesDir, entry.name, 'index.astro')),
      )
      .map((entry) => readAppMeta(astroSourcesDir, entry.name))
  : [];

// Both kinds share the /app/<name>/ URL space; merge newest first.
const apps = [...legacyApps, ...astroApps].sort((a, b) => b.date.localeCompare(a.date));
const t = translations['en'] ?? {};
---

<Base title="Apps · GMQ's Tech Haven">
  <h1>Apps</h1>
  {apps.length === 0 ? (
    <p>No apps yet.</p>
  ) : (
    <ul class="app-list">
      {
        apps.map((app) => (
          <li>
            <a href={`/app/${app.name}/`}>
              <span>{app.title}</span>
              {app.date && <time datetime={app.date}>{app.date}</time>}
            </a>
            {app.introduction && <p>{app.introduction}</p>}
          </li>
        ))
      }
    </ul>
  )}
</Base>