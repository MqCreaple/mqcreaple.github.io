---
// ModulationPanel.astro — one static panel shared by every knob.
// The client keeps a reference to the knob that opened it, repositions it to
// the clicked knob, and toggles it when the same knob is right-clicked again.

import Knob from './Knob.astro';
import { MODULATION_SOURCES } from '../config.ts';
---

<section class="knob-panel" id="chaotic-mod-panel" hidden>
  <div class="knob-panel-title">Modulate</div>
  {MODULATION_SOURCES.map((source) => (
    <div class="knob-panel-row">
      <span class="knob-panel-name">{source.name}</span>
      <button type="button" class="knob-panel-toggle" data-mod-source={source.id}>off</button>
    </div>
  ))}
  <div class="knob-panel-amp knob-panel-amp--hidden">
    <Knob inst="panel" param="amp" label="Amplitude" min={-1} max={1} step={0.01} precision={2} value={0} />
  </div>
</section>
