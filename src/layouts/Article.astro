---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import Avatar from '../components/Avatar.astro';
import ShadertoyFigureBuilder from '../components/ShadertoyFigureBuilder.astro';
import TagCloud from '../components/TagCloud.astro';
import ThreeJsDiagramBuilder from '../components/ThreeJsDiagramBuilder.astro';
import Base from './Base.astro';
import translations from '../i18n/translations.json';

interface Props {
  lang: string;
  title: string;
  date: string;
  id: string;
  summary?: string;
  pdf?: string;
  htmlHeads?: string[];
}

const { lang, title, date, id, summary = '', pdf, htmlHeads = [] } = Astro.props;
const fragmentPath = path.join(process.cwd(), 'src', 'generated', 'articles', `${id}.html`);
const fragment = readFileSync(fragmentPath, 'utf-8');
const hasThreeJsFigure = fragment.includes('three-js-figure');
const hasShadertoyFigure = fragment.includes('shadertoy-figure');
const t = translations[lang] ?? translations.en;
const dateLabel = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
  dateStyle: 'long',
}).format(new Date(date));

function headAssets(heads: string[]): string {
  return heads
    .map((head) => {
      const url = (head.startsWith('/') ? head : '/' + head).replaceAll('\\', '/');
      if (url.endsWith('.css')) {
        return `<link rel="stylesheet" href="${url}" />`;
      }
      if (url.endsWith('.js')) {
        return `<script src="${url}"></script>`;
      }
      return '';
    })
    .filter(Boolean)
    .join('\n');
}

const headHtml = headAssets(htmlHeads);
---

<Base title={`${title} · GMQ's Tech Haven`} description={summary} lang={lang}>
  {headHtml && <Fragment slot="head" set:html={headHtml} />}
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta" data-pagefind-ignore><time datetime={date}>{dateLabel}</time></p>
    </header>
    <div class="typst-content" set:html={fragment} />
    {pdf && (
      <p class="post-pdf" data-pagefind-ignore>
        <a href={pdf}>
          <i class="fa-solid fa-file-pdf"></i>
          {t.downloadPdf}
        </a>
      </p>
    )}
  </article>
  {hasThreeJsFigure && <ThreeJsDiagramBuilder />}
  {hasShadertoyFigure && <ShadertoyFigureBuilder />}
  <Avatar slot="aside" lang={lang} />
  <TagCloud slot="aside" lang={lang} />
</Base>
