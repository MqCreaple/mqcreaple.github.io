<script>
  // Three.js core plus OrbitControls for interactive camera dragging.
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { OBJLoader } from 'three/addons/loaders/OBJLoader.js';
  import { mergeGeometries, mergeVertices } from 'three/addons/utils/BufferGeometryUtils.js';

  // Contract between the builder and the per-post scene construction scripts.
  type InitialView = [number, number, number];

  type ControlDef =
    | { type: 'button'; label: string; action: () => void }
    | { type: 'checkbox'; label: string; checked?: boolean; action: (checked: boolean) => void }
    | {
        type: 'number' | 'range';
        label: string;
        min?: number;
        max?: number;
        value?: number;
        step?: number;
        action: (value: number) => void;
      };

  interface DiagramHelpers {
    THREE: typeof THREE;
    makeTextSprite: (message: string, color: string) => THREE.Sprite;
    resetView: () => void;
    addControlWidget: (def: ControlDef) => void;
    toggleLabels: (labelSprites: THREE.Sprite[]) => () => void;
    OBJLoader: typeof OBJLoader;
    mergeGeometries: typeof mergeGeometries;
    mergeVertices: typeof mergeVertices;
    // Register a per-frame callback (dt in seconds), invoked before the
    // active camera controls update and before the scene is rendered.
    onFrame: (callback: (dt: number) => void) => void;
    // Camera controls are opt-in: a scene script creates the controls it
    // needs (orbit, or a player-following camera) through this module.
    cameraControls: {
      createOrbit: () => OrbitControls;
      createPlayerFollowing: (
        player: THREE.Object3D,
        canvas: HTMLCanvasElement,
      ) => PlayerFollowingControls;
    };
  }

  type DiagramBuilder = (
    scene: THREE.Scene,
    camera: THREE.PerspectiveCamera,
    canvas: HTMLCanvasElement,
    initialView: InitialView,
    helpers: DiagramHelpers,
  ) => void;

  // Parses the optional data-initial-view attribute into a camera position.
  function parseInitialView(value: string | undefined): InitialView {
    if (!value) return [3, 0, -3];
    const parts = value.split(',').map((part) => Number(part.trim()));
    if (parts.length === 3 && parts.every((part) => Number.isFinite(part))) {
      return [parts[0], parts[1], parts[2]];
    }
    return [3, 0, -3];
  }

  // Renders a text label onto a canvas texture so it can live in the 3D scene.
  function makeTextSprite(message: string, color: string): THREE.Sprite {
    const canvas = document.createElement('canvas');
    const context = canvas.getContext('2d');
    if (!context) throw new Error('ThreeJsDiagramBuilder: 2D canvas context is unavailable.');
    canvas.width = 256;
    canvas.height = 128;
    context.clearRect(0, 0, 256, 128);
    context.font = 'bold 24px Arial';
    context.textAlign = 'center';
    context.textBaseline = 'middle';
    context.fillStyle = color;
    context.fillText(message, 128, 64);

    const texture = new THREE.CanvasTexture(canvas);
    texture.minFilter = THREE.LinearFilter;
    const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture }));
    sprite.scale.set(1.5, 0.75, 1);
    return sprite;
  }

  // A camera control that follows a player object from behind, keeping the
  // camera upright relative to the player's "up" axis (e.g. the surface
  // normal), so the local surface appears flat like a ground plane.
  // Horizontal dragging on the canvas rotates the player around its up axis.
  class PlayerFollowingControls {
    camera: THREE.PerspectiveCamera;
    player: THREE.Object3D;
    canvas: HTMLCanvasElement;
    distance: number;
    height: number;
    lookAhead: number;
    rotateSpeed: number;
    positionSmoothing: number;
    orientationSmoothing: number;

    private dragging = false;
    private lastX = 0;
    private targetPosition = new THREE.Vector3();
    private targetLook = new THREE.Vector3();

    private onPointerDown: (event: PointerEvent) => void;
    private onPointerMove: (event: PointerEvent) => void;
    private onPointerUp: (event: PointerEvent) => void;

    constructor(
      camera: THREE.PerspectiveCamera,
      player: THREE.Object3D,
      canvas: HTMLCanvasElement,
    ) {
      this.camera = camera;
      this.player = player;
      this.canvas = canvas;
      this.distance = 4;
      this.height = 1.4;
      this.lookAhead = 1;
      this.rotateSpeed = 0.004;
      this.positionSmoothing = 8;
      this.orientationSmoothing = 8;

      this.onPointerDown = (event) => {
        this.dragging = true;
        this.lastX = event.clientX;
        this.canvas.setPointerCapture?.(event.pointerId);
      };
      this.onPointerMove = (event) => {
        if (!this.dragging) return;
        const dx = event.clientX - this.lastX;
        this.lastX = event.clientX;
        this.player.rotateOnWorldAxis(this.player.up, -dx * this.rotateSpeed);
      };
      this.onPointerUp = (event) => {
        this.dragging = false;
        this.canvas.releasePointerCapture?.(event.pointerId);
      };
      this.canvas.addEventListener('pointerdown', this.onPointerDown);
      this.canvas.addEventListener('pointermove', this.onPointerMove);
      this.canvas.addEventListener('pointerup', this.onPointerUp);
    }

    dispose(): void {
      this.canvas.removeEventListener('pointerdown', this.onPointerDown);
      this.canvas.removeEventListener('pointermove', this.onPointerMove);
      this.canvas.removeEventListener('pointerup', this.onPointerUp);
    }

    // Called by the builder every frame with the frame time delta (seconds).
    update(dt = 0): void {
      const position = this.player.getWorldPosition(new THREE.Vector3());
      const forward = this.player.getWorldDirection(new THREE.Vector3());
      const up = this.player.up;

      this.targetPosition
        .copy(position)
        .addScaledVector(forward, -this.distance)
        .addScaledVector(up, this.height);
      const t = 1 - Math.exp(-this.positionSmoothing * dt);
      this.camera.position.lerp(this.targetPosition, t);

      this.targetLook
        .copy(position)
        .addScaledVector(forward, this.lookAhead)
        .addScaledVector(up, this.height * 0.5);
      this.camera.up.copy(up);
      this.camera.lookAt(this.targetLook);
    }
  }

  // The active controls share a per-frame update entry point.
  type ActiveControls = { update: (dt?: number) => void };

  interface CameraControlsModule {
    _active: (OrbitControls | PlayerFollowingControls) | null;
    createOrbit: () => OrbitControls;
    createPlayerFollowing: (
      player: THREE.Object3D,
      canvas: HTMLCanvasElement,
    ) => PlayerFollowingControls;
    update: (dt: number) => void;
    resetView: () => void;
  }

  // Builds the camera-controls module exposed to scene scripts as
  // helpers.cameraControls. The module tracks whichever controls the scene
  // script created so the builder can update them each frame.
  function createCameraControlsModule(
    camera: THREE.PerspectiveCamera,
    canvas: HTMLCanvasElement,
    initialView: InitialView,
  ): CameraControlsModule {
    const module: CameraControlsModule = {
      _active: null,

      createOrbit() {
        const controls = new OrbitControls(camera, canvas);
        controls.enableDamping = true;
        controls.dampingFactor = 0.2;
        controls.screenSpacePanning = false;
        controls.minDistance = 2;
        controls.maxDistance = 30;
        this._active = controls;
        return controls;
      },

      createPlayerFollowing(player, followCanvas) {
        const controls = new PlayerFollowingControls(camera, player, followCanvas);
        this._active = controls;
        return controls;
      },

      update(dt) {
        const active = this._active as ActiveControls | null;
        active?.update(dt);
      },

      resetView() {
        camera.up.set(0, 1, 0);
        camera.position.set(...initialView);
        camera.lookAt(0, 0, 0);
        const active = this._active;
        if (active && 'target' in active) {
          active.target.set(0, 0, 0);
          active.update();
        }
      },
    };
    return module;
  }

  // Builds an action that toggles a set of label sprites on and off.
  function toggleLabels(labelSprites: THREE.Sprite[]): () => void {
    let visible = true;
    return () => {
      visible = !visible;
      for (const sprite of labelSprites) sprite.visible = visible;
    };
  }

  // Creates the DOM element for one scene control (button, checkbox, slider).
  function createControlElement(figureId: string, def: ControlDef, index: number): HTMLDivElement {
    const id = `${figureId}-control-${index}`;
    const wrap = document.createElement('div');
    wrap.style.display = 'flex';
    wrap.style.alignItems = 'center';
    wrap.style.gap = '4px';

    switch (def.type) {
      case 'button': {
        const button = document.createElement('button');
        button.id = id;
        button.textContent = def.label;
        button.addEventListener('click', def.action);
        wrap.appendChild(button);
        break;
      }
      case 'checkbox': {
        const label = document.createElement('label');
        label.textContent = def.label;
        label.htmlFor = id;
        const input = document.createElement('input');
        input.type = 'checkbox';
        if (def.checked) input.checked = true;
        input.id = id;
        input.addEventListener('change', () => def.action(input.checked));
        wrap.appendChild(label);
        wrap.appendChild(input);
        break;
      }
      case 'number':
      case 'range': {
        const label = document.createElement('label');
        label.textContent = def.label;
        label.htmlFor = id;
        const input = document.createElement('input');
        input.type = def.type;
        input.id = id;
        if (def.min !== undefined) input.min = String(def.min);
        if (def.max !== undefined) input.max = String(def.max);
        if (def.value !== undefined) input.value = String(def.value);
        if (def.step !== undefined) input.step = String(def.step);
        input.addEventListener('input', () => def.action(parseFloat(input.value)));
        wrap.appendChild(label);
        wrap.appendChild(input);
        break;
      }
      default:
        console.warn('ThreeJsDiagramBuilder: unknown control type');
    }

    return wrap;
  }

  // Shows a fallback message inside the figure when something goes wrong.
  function showError(container: HTMLElement, message: string): void {
    const error = document.createElement('div');
    error.className = 'three-js-error';
    error.textContent = message;
    container.appendChild(error);
  }

  // Main entry point: sets up one Three.js scene inside a figure container.
  async function buildDiagram(container: HTMLElement, figureId: string): Promise<void> {
    const src = container.dataset.src;
    if (!src) return;

    const initialView = parseInitialView(container.dataset.initialView);
    const canvas = document.createElement('canvas');
    canvas.className = 'three-js-canvas';
    container.appendChild(canvas);

    // Base scene and perspective camera, initially looking at the origin.
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xf0f0f0);

    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 50);
    camera.position.set(...initialView);
    camera.lookAt(0, 0, 0);

    // Renderer creation can throw when WebGL is unavailable.
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    } catch (error) {
      console.error('ThreeJsDiagramBuilder: WebGL is not available', error);
      showError(container, 'Three.js diagram requires WebGL support.');
      return;
    }

    const getSize = (): [number, number] => [
      canvas.clientWidth || container.clientWidth || window.innerWidth,
      canvas.clientHeight || container.clientHeight || 400,
    ];

    const setSize = (): void => {
      const [width, height] = getSize();
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
      renderer.setPixelRatio(window.devicePixelRatio);
    };
    setSize();

    // Frame loop bookkeeping: per-frame callbacks and the opt-in controls.
    const clock = new THREE.Clock();
    const frameCallbacks: Array<(dt: number) => void> = [];
    const cameraControlsModule = createCameraControlsModule(camera, canvas, initialView);

    // Simple ambient + directional lighting so materials are visible.
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
    directionalLight.position.set(5, 10, 7);
    scene.add(directionalLight);

    const controlWidgetContainer = document.createElement('div');
    controlWidgetContainer.className = 'three-js-controls';
    container.appendChild(controlWidgetContainer);

    // Scene scripts append interactive control widgets through addControl.
    const controlElements: HTMLDivElement[] = [];
    const addControlWidget = (def: ControlDef): void => {
      const element = createControlElement(figureId, def, controlElements.length);
      controlWidgetContainer.appendChild(element);
      controlElements.push(element);
    };

    // Render loop: run per-frame callbacks, update the active camera controls,
    // then draw the scene each frame.
    function animate(): void {
      requestAnimationFrame(animate);
      const dt = clock.getDelta();
      for (const callback of frameCallbacks) callback(dt);
      cameraControlsModule.update(dt);
      renderer.render(scene, camera);
    }
    animate();

    // Keep the canvas and camera aspect ratio in sync with the container.
    const resizeObserver = new ResizeObserver(setSize);
    resizeObserver.observe(container);

    // Utilities exposed to the loaded scene script.
    const helpers: DiagramHelpers = {
      THREE,
      makeTextSprite,
      resetView: () => cameraControlsModule.resetView(),
      addControlWidget,
      toggleLabels,
      OBJLoader,
      mergeGeometries,
      mergeVertices,
      onFrame: (callback) => {
        frameCallbacks.push(callback);
      },
      cameraControls: cameraControlsModule,
    };

    // Load the post's construction script and let it populate the scene.
    try {
      const module = (await import(/* @vite-ignore */ src)) as { default?: DiagramBuilder };
      if (typeof module.default !== 'function') {
        throw new Error(`Module ${src} does not export a default builder function`);
      }
      module.default(scene, camera, canvas, initialView, helpers);
    } catch (error) {
      console.error(`ThreeJsDiagramBuilder: failed to build diagram from ${src}`, error);
      showError(container, 'Failed to load the Three.js diagram script.');
    }
  }

  // Enhance every three-js-figure container emitted by Typst.
  const figures = document.querySelectorAll<HTMLElement>('.three-js-figure[data-src]');
  figures.forEach((figure, index) => {
    const figureId = figure.id || `three-js-figure-${index}`;
    figure.id = figureId;
    void buildDiagram(figure, figureId);
  });
</script>
