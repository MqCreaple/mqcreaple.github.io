---
import translations from '../i18n/translations.json';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang as keyof typeof translations] ?? translations.en;
const year = new Date().getFullYear();
const email = 'gmq14159@gmail.com';
const copyright = t.footer.copyright.replace('{year}', String(year));
const licenseParts = t.footer.license.split(/(CC-BY-NC-SA 4\.0)/gi);
---

<footer class="site-footer">
  <p>{copyright}</p>
  <p>
    Powered by <a href="https://astro.build">Astro</a> + <a href="https://typst.app">Typst</a>
    |
    <a href={`mailto:${email}`}><i class="fa-solid fa-envelope"></i> {t.footer.contact}</a>
  </p>
  <p>
    {
      licenseParts.map((part: string, index: number) =>
        part.toLowerCase() === 'cc-by-nc-sa 4.0' ? (
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">{part}</a>
        ) : (
          part
        ),
      )
    }
  </p>
</footer>
