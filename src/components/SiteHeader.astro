---
import translations from '../i18n/translations.json';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';

interface Props {
  lang?: string;
  links?: Record<string, string>;
}

const { lang = 'en', links = {} } = Astro.props;
const t = translations[lang as keyof typeof translations] ?? translations.en;
const navLinks: { href: string; label: string; icon: string }[] = [
  { href: `/${lang}/`, label: t.nav.blog, icon: 'fa-regular fa-file-lines' },
  { href: `/${lang}/aboutme/`, label: t.nav.aboutme, icon: 'fa-solid fa-user' },
  { href: '/apps/', label: t.nav.app, icon: 'fa-solid fa-cubes-stacked' },
];
---

<header class="site-header">
  <div class="site-header-inner">
    <div class="site-brand-nav">
      <a class="site-title" href={`/${lang}/`}>{t.siteTitle}</a>
      <nav class="site-nav" aria-label="Sections">
        {
          navLinks.map((link) => (
            <a href={link.href}>
              <i class={link.icon}></i>
              <span>{link.label}</span>
            </a>
          ))
        }
      </nav>
    </div>
    <div class="site-actions">
      <SearchBox lang={lang} />
      <LangSwitcher currentLang={lang} links={links} />
      <ThemeToggle />
    </div>
  </div>
</header>
